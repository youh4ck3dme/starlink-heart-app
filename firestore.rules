rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidScope(scope) {
      return scope in ['class', 'school', 'global'];
    }

    function isAllowedTrend(trend) {
      return trend in ['up', 'down', 'same'];
    }

    function isValidLeaderboardWrite(scope, entryUserId) {
      return isValidScope(scope)
        && isOwner(entryUserId)
        && request.resource.data.id == entryUserId
        && request.resource.data.userId == entryUserId
        && request.resource.data.scope == scope
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.avatar is string
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.badges is list
        && isAllowedTrend(request.resource.data.trend);
    }

    // User private space
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Chat history and AI responses
      match /hearts/{heartId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // Leaderboards by scope
    match /leaderboards/{scope}/entries/{entryUserId} {
      allow read: if isSignedIn() && isValidScope(scope);
      allow create, update: if isValidLeaderboardWrite(scope, entryUserId);
      allow delete: if isOwner(entryUserId) && isValidScope(scope);
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
